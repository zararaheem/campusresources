# ─────────────────────────────────────────────────────────────
# Campus Handbook — environment variables
# Copy to `.env.local` for local dev, and set these in Vercel for prod.
# ─────────────────────────────────────────────────────────────

# ── Auth.js (Google sign-in for the editor backend) ──────────
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth 2.0 credentials (Google Cloud Console → Credentials → OAuth client ID → "Web application")
# Authorized redirect URI must be:  https://YOUR-DOMAIN/api/auth/callback/google
#   ...and for local dev:            http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails allowed to sign in the FIRST time (they get seeded into the
# editors allowlist). After that, editors are managed from inside /admin.
SEED_EDITOR_EMAILS=zara.raheem@alpha.school

# ── Supabase (production data backend) ───────────────────────
# Project Settings → API. If these are set, the app uses Supabase.
# If they are NOT set, the app falls back to a local JSON file store (dev only).
NEXT_PUBLIC_SUPABASE_URL=
# The service-role key is used server-side only (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# ── AI chat (Claude) ─────────────────────────────────────────
# Powers the "Ask" chat on the handbook. Get a key at console.anthropic.com.
# Without it, the handbook still works; the Ask button shows a "not set up" message.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# ── Local development convenience ────────────────────────────
# Set to "true" to bypass Google sign-in locally (acts as the first SEED_EDITOR_EMAILS
# user). NEVER enable this in production.
AUTH_DEV_BYPASS=false
